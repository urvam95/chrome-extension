{
  "manifest_version": 3,
  "name": "React Google Maps Extension",
  "version": "1.0",
  "description": "A Chrome extension using Google Maps with React.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "geolocation", "scripting", "activeTab"],
  "host_permissions": ["https://maps.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
